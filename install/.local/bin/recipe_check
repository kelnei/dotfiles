#!/usr/bin/env bash
set -euo pipefail

CHECK_DIR="$HOME/.local/share/install/checks"

usage() {
  echo "Usage: recipe_check <recipe> [recipe ...]"
  echo "       recipe_check --list"
  echo ""
  echo "Check for available updates to installed tools."
}

list_checks() {
  echo "Available checks:"
  for CHECK in "$CHECK_DIR"/*; do
    [ -f "$CHECK" ] && [ -x "$CHECK" ] && echo "  $(basename "$CHECK")"
  done
}

run_check() {
  CHECK="$CHECK_DIR/$1"
  if [ ! -f "$CHECK" ]; then
    echo "error: unknown check '$1'" >&2
    echo "run 'recipe_check --list' to see available checks" >&2
    return 1
  fi
  "$CHECK"
}

if [ $# -eq 0 ]; then
  usage
  exit 1
fi

case "$1" in
--list | -l)
  list_checks
  exit 0
  ;;
--help | -h)
  usage
  exit 0
  ;;
esac

for CHECK_NAME in "$@"; do
  run_check "$CHECK_NAME"
done
