#!/usr/bin/env bash
set -euo pipefail

RECIPE_DIR="$HOME/.local/share/install/recipes"

# shellcheck source=/dev/null
source "$RECIPE_DIR/_lib.sh"

usage() {
  echo "Usage: recipe_install <recipe> [recipe ...]"
  echo "       recipe_install --list"
  echo ""
  echo "Install developer tools that aren't installed yet. Already-installed"
  echo "tools are skipped - use recipe_update to update them."
}

list_recipes() {
  echo "Available recipes:"
  for RECIPE in "$RECIPE_DIR"/*; do
    [ -f "$RECIPE" ] && [ -x "$RECIPE" ] && echo "  $(basename "$RECIPE")"
  done
}

run_recipe() {
  RECIPE=$(require_recipe "$1") || return 1

  # "all" is a meta-recipe - it already skips per-tool internally
  if [ "$1" != "all" ] && recipe_is_installed "$1"; then
    recipe_announce_skip "$1"
    return 0
  fi

  echo ""
  echo "==> $1"
  "$RECIPE"
}

if [ $# -eq 0 ]; then
  usage
  exit 1
fi

case "$1" in
--list | -l)
  list_recipes
  exit 0
  ;;
--help | -h)
  usage
  exit 0
  ;;
esac

for RECIPE_NAME in "$@"; do
  run_recipe "$RECIPE_NAME"
done
