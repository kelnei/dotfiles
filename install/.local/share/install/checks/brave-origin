#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

ARCH=$(recipe_arch deb)
LATEST=$(apt_package_version "https://brave-browser-apt-nightly.s3.brave.com/dists/stable/main/binary-${ARCH}/Packages" brave-origin-nightly)

# brave origin --version includes the chromium major version
INSTALLED=$(brave-origin-nightly --version 2>/dev/null | awk '{N = split($4, V, "."); if (N == 4) print V[2] "." V[3] "." V[4]; else print $4}') || INSTALLED="not installed"

check_version brave-origin "$INSTALLED" "$LATEST"
