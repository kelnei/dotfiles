#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

# parse version from the stable channel manifest
LATEST=$(curl -fsSL https://static.rust-lang.org/dist/channel-rust-stable.toml | grep -A1 '^\[pkg\.rust\]' | grep 'version' | sed 's/version = "\([^ ]*\).*/\1/')

# "rustc 1.94.0 (4a4ef493e 2026-03-02)" -> "1.94.0"
INSTALLED=$(rustc --version 2>/dev/null | awk '{print $2}') || INSTALLED="not installed"

check_version rust "$INSTALLED" "$LATEST"
