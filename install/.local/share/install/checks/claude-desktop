#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

ARCH=$(recipe_arch deb)
LATEST=$(apt_package_version "https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-${ARCH}/Packages" claude-desktop)

INSTALLED=$(dpkg-query -W -f='${Version}' claude-desktop 2>/dev/null) || INSTALLED="not installed"

check_version claude-desktop "$INSTALLED" "$LATEST"
