#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

# the newest release does not always ship a package for this distro - ghostty
# 1.4+ dropped ubuntu 24.04, and the upstream installer then stays on the last
# compatible release - so "latest" is the newest release that has a .deb for
# this machine, matching what the recipe will actually install
# packages are named ghostty_<version>_<arch>_<ubuntu version or debian codename>.deb
source /etc/os-release
ARCH=$(recipe_arch deb)

LATEST=$(github_api "/repos/mkasberg/ghostty-ubuntu/releases?per_page=100" |
  grep -oE "releases/download/[^/\"]+/ghostty_[^/\"_]+_${ARCH}_(${VERSION_ID:-none}|${VERSION_CODENAME:-none})\.deb" |
  awk -F/ 'NR == 1 {print $3}')
LATEST="${LATEST%%-*}"

INSTALLED=$(ghostty --version 2>/dev/null | awk 'NR == 1 {print $2}') || INSTALLED="not installed"

check_version ghostty "$INSTALLED" "$LATEST"
