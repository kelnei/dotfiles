#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# GUI apps — skipped on headless server environments (no DISPLAY or WAYLAND_DISPLAY)
GUI_CHECKS=(
  1password
  brave
  brave-origin
  lmstudio
)

CHECKS=(
  starship
  go
  rust
  uv
  ruff
  bun
  gh
  aws
  ssm
  ripgrep
  shellcheck
  shfmt
  fzf
  bat
  just
  docker
  1password
  op
  gopass
  proton_pass
  fnm
  pnpm
  claude
  codex
  opencode
  neovim
  ghostty
  tmux
  brave
  brave-origin
  lmstudio
)

is_gui_check() {
  local name="$1"
  for gui in "${GUI_CHECKS[@]}"; do
    [ "$name" = "$gui" ] && return 0
  done
  return 1
}

IS_SERVER=0
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  IS_SERVER=1
  echo "headless environment detected: skipping GUI app checks (${GUI_CHECKS[*]})"
fi

for CHECK in "${CHECKS[@]}"; do
  if [ "$IS_SERVER" = 1 ] && is_gui_check "$CHECK"; then
    continue
  fi
  "$SCRIPT_DIR/$CHECK" || echo "$CHECK: check failed"
done
