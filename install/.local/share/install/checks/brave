#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

LATEST=$(curl -fsSL "https://brave-browser-apt-release.s3.brave.com/dists/stable/main/binary-amd64/Packages" | awk '/^Package: brave-browser$/{FOUND=1} FOUND && /^Version: /{print $2; exit}')

# brave --version includes the chromium major version
INSTALLED=$(brave-browser --version 2>/dev/null | awk '{N = split($3, V, "."); if (N == 4) print V[2] "." V[3] "." V[4]; else print $3}') || INSTALLED="not installed"

check_version brave "$INSTALLED" "$LATEST"
