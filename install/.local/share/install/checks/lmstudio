#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

ARCH=$(recipe_arch x64)
LATEST=$(curl -fsSI "https://lmstudio.ai/download/latest/linux/${ARCH}?format=deb" | awk -F/ 'tolower($1) == "location: https:" {print $(NF - 1); exit}')

# debian package version uses plus instead of the redirect hyphen
LATEST="${LATEST/-/+}"

INSTALLED=$(dpkg-query -W -f='${Version}' lm-studio 2>/dev/null) || INSTALLED="not installed"

check_version lmstudio "$INSTALLED" "$LATEST"
