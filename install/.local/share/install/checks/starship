#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

LATEST=$(github_latest starship/starship)
LATEST="${LATEST#v}"

# "starship 1.24.2" -> "1.24.2"
INSTALLED=$(starship --version 2>/dev/null | head -1 | awk '{print $2}') || INSTALLED="not installed"

check_version starship "$INSTALLED" "$LATEST"
