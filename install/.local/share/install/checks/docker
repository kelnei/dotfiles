#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

# tag is "docker-v29.3.1"
LATEST=$(github_latest moby/moby)
LATEST="${LATEST#docker-v}"

# "Docker version 29.3.1, build c2be9cc" -> "29.3.1"
INSTALLED=$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',') || INSTALLED="not installed"

check_version docker "$INSTALLED" "$LATEST"
