#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

LATEST=$(curl -fsSL https://registry.npmjs.org/@openai/codex/latest | grep -o '"version":"[^"]*"' | head -1 | cut -d'"' -f4)

# "codex-cli 0.117.0" -> "0.117.0"
INSTALLED=$(codex --version 2>/dev/null | awk '{print $2}') || INSTALLED="not installed"

check_version codex "$INSTALLED" "$LATEST"
