#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

LATEST=$(curl -fsSL "https://downloads.1password.com/linux/debian/amd64/dists/stable/main/binary-amd64/Packages" | awk '/^Package: 1password$/{FOUND=1} FOUND && /^Version: /{print $2; exit}')

INSTALLED=$(dpkg-query -W -f='${Version}' 1password 2>/dev/null) || INSTALLED="not installed"

check_version 1password "$INSTALLED" "$LATEST"
