#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

LATEST=$(curl -fsSL https://registry.npmjs.org/@anthropic-ai/claude-code/latest | grep -o '"version":"[^"]*"' | head -1 | cut -d'"' -f4)

# "2.1.87 (Claude Code)" -> "2.1.87"
INSTALLED=$(claude --version 2>/dev/null | awk '{print $1}') || INSTALLED="not installed"

check_version claude "$INSTALLED" "$LATEST"
