#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

# 1password's apt pool only carries the desktop app for amd64 (the arm64 pool
# has just 1password-cli) - fail early rather than dpkg-erroring on the wrong deb
if [ "$(recipe_arch deb)" != amd64 ]; then
  echo "error: the 1Password desktop app is not packaged for $(uname -m) Linux" >&2
  exit 1
fi

# prompt for sudo credentials upfront
sudo -v

echo "Installing gnupg2 (1Password dependency)..."
sudo apt-get install -y gnupg2

echo "Installing latest 1Password desktop app..."
curl -fsSL "https://downloads.1password.com/linux/debian/amd64/stable/1password-latest.deb" -o /tmp/1password.deb
sudo dpkg -i /tmp/1password.deb
rm /tmp/1password.deb

echo "1Password installed"
echo "Sign in at https://start.1password.com and then select 'Set up another device' to add your account"
