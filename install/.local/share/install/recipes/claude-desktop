#!/usr/bin/env bash
set -euo pipefail

# prompt for sudo credentials upfront
sudo -v

echo "Installing latest Claude Desktop..."

# add anthropic's apt repository so updates arrive via apt
sudo curl -fsSLo /usr/share/keyrings/claude-desktop-archive-keyring.asc https://downloads.claude.ai/claude-desktop/key.asc
echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/claude-desktop-archive-keyring.asc] https://downloads.claude.ai/claude-desktop/apt/stable stable main" |
  sudo tee /etc/apt/sources.list.d/claude-desktop.list

sudo apt update
sudo apt install -y claude-desktop

echo "claude-desktop $(dpkg-query -W -f='${Version}' claude-desktop) installed"
