#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

INSTALL_DIR="$HOME/.local/bin"
TMP_DIR=$(mktemp -d)
ARCH=$(recipe_arch deb)

echo "Fetching latest gopass release..."
LATEST=$(github_latest gopasspw/gopass)
: "${LATEST:?failed to parse latest release tag}"
VERSION="${LATEST#v}"

echo "Installing gopass ${LATEST}..."
github_download gopasspw/gopass "$LATEST" "gopass-${VERSION}-linux-${ARCH}.tar.gz" |
  tar -xz -C "$TMP_DIR"
mv "$TMP_DIR/gopass" "$INSTALL_DIR/gopass"
rm -rf "$TMP_DIR"

echo "gopass $("$INSTALL_DIR/gopass" version) installed to $INSTALL_DIR/gopass"
echo "Run 'gopass init' to set up your password store"
