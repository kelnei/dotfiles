#!/usr/bin/env bash
set -euo pipefail

INSTALL_PREFIX="$HOME/.local"
INSTALL_DIR="$INSTALL_PREFIX/bin"
TMP_DIR=$(mktemp -d)

# prompt for sudo credentials upfront
sudo -v

echo "Fetching latest tmux release..."
LATEST=$(curl -fsSL https://api.github.com/repos/tmux/tmux/releases/latest | grep '"tag_name"' | cut -d'"' -f4)
VERSION="${LATEST#v}"

echo "Installing tmux build dependencies..."
sudo apt-get install -y build-essential bison pkg-config libevent-dev libncurses-dev

echo "Installing tmux $VERSION..."
mkdir -p "$INSTALL_DIR"
curl -fsSL "https://github.com/tmux/tmux/releases/download/${LATEST}/tmux-${VERSION}.tar.gz" |
  tar -xz -C "$TMP_DIR"
cd "$TMP_DIR/tmux-$VERSION"
./configure --prefix="$INSTALL_PREFIX"
make
make install
cd "$HOME"
rm -rf "$TMP_DIR"

# install TPM (tmux plugin manager)
TPM_DIR="$HOME/.tmux/plugins/tpm"
if [ ! -d "$TPM_DIR" ]; then
  echo "Installing TPM..."
  git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
else
  echo "TPM already installed, updating..."
  git -C "$TPM_DIR" pull
fi

echo "tmux $("$INSTALL_DIR/tmux" -V) installed to $INSTALL_DIR/tmux"
echo "Launch tmux and press Ctrl+Space I to install plugins"
