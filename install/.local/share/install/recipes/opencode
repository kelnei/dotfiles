#!/usr/bin/env bash
set -euo pipefail

OPENCODE="$HOME/.opencode/bin/opencode"

if [ -x "$OPENCODE" ]; then
  echo "Updating opencode..."
  "$OPENCODE" upgrade
else
  echo "Installing latest opencode..."
  # the unversioned installer only installs opencode 1
  curl -fsSL https://opencode.ai/v2/install | bash
fi

echo "$("$OPENCODE" --version) installed"
