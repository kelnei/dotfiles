#!/usr/bin/env bash
set -euo pipefail

OPENCODE="$HOME/.opencode/bin/opencode"

if [ -x "$OPENCODE" ]; then
  echo "Updating opencode..."
  "$OPENCODE" upgrade
else
  echo "Installing latest opencode..."
  curl -fsSL https://opencode.ai/install | bash
fi

echo "opencode $("$OPENCODE" --version) installed"
