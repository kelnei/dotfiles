#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

INSTALL_DIR="$HOME/.local/bin"
TMP_DIR=$(mktemp -d)

echo "Installing latest codex..."
LATEST=$(github_latest openai/codex)
: "${LATEST:?failed to parse latest release tag}"

echo "Installing codex ${LATEST#rust-v}..."
github_download openai/codex "$LATEST" "codex-x86_64-unknown-linux-musl.tar.gz" |
  tar -xz -C "$TMP_DIR"
mv "$TMP_DIR/codex-x86_64-unknown-linux-musl" "$INSTALL_DIR/codex"
rm -rf "$TMP_DIR"

echo "codex $("$INSTALL_DIR/codex" --version) installed to $INSTALL_DIR/codex"
