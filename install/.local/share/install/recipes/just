#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

INSTALL_DIR="$HOME/.local/bin"
TMP_DIR=$(mktemp -d)

echo "Fetching latest just release..."
LATEST=$(github_latest casey/just)
: "${LATEST:?failed to parse latest release tag}"

echo "Installing just $LATEST..."
github_download casey/just "$LATEST" "just-${LATEST}-x86_64-unknown-linux-musl.tar.gz" |
  tar -xz -C "$TMP_DIR"
mv "$TMP_DIR/just" "$INSTALL_DIR/just"
rm -rf "$TMP_DIR"

echo "just $($INSTALL_DIR/just --version) installed to $INSTALL_DIR/just"
