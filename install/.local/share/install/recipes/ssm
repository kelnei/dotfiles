#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

case "$(recipe_arch deb)" in
amd64) ARCH=ubuntu_64bit ;;
arm64) ARCH=ubuntu_arm64 ;;
esac

# prompt for sudo credentials upfront
sudo -v

echo "Installing latest session manager plugin..."
curl -fsSL "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/${ARCH}/session-manager-plugin.deb" -o /tmp/session-manager-plugin.deb
sudo dpkg -i /tmp/session-manager-plugin.deb
rm /tmp/session-manager-plugin.deb

echo "session-manager-plugin $(session-manager-plugin --version) installed"
