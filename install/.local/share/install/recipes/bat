#!/usr/bin/env bash
set -euo pipefail

# prompt for sudo credentials upfront
sudo -v

echo "Fetching latest bat release..."
LATEST=$(curl -fsSL https://api.github.com/repos/sharkdp/bat/releases/latest | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
: "${LATEST:?failed to parse latest release tag}"
VERSION="${LATEST#v}"

echo "Installing bat ${LATEST}..."
curl -fsSL "https://github.com/sharkdp/bat/releases/download/${LATEST}/bat_${VERSION}_amd64.deb" -o /tmp/bat.deb
sudo dpkg -i /tmp/bat.deb
rm /tmp/bat.deb

echo "bat $(bat --version) installed"
