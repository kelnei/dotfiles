#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

INSTALL_DIR="$HOME/.local/bin"
CONFIG_DIR="$HOME/.cli-proxy-api"
TMP_DIR=$(mktemp -d)

# upstream names the intel asset linux_amd64 but the arm asset linux_aarch64
case "$(recipe_arch deb)" in
amd64) ARCH=amd64 ;;
arm64) ARCH=aarch64 ;;
esac

echo "Installing latest cli-proxy-api..."
LATEST=$(github_latest router-for-me/CLIProxyAPI)
: "${LATEST:?failed to parse latest release tag}"
VERSION="${LATEST#v}"

echo "Installing cli-proxy-api ${VERSION}..."
github_download router-for-me/CLIProxyAPI "$LATEST" "CLIProxyAPI_${VERSION}_linux_${ARCH}.tar.gz" |
  tar -xz -C "$TMP_DIR" cli-proxy-api config.example.yaml
mv "$TMP_DIR/cli-proxy-api" "$INSTALL_DIR/cli-proxy-api"

# keep the example current for diffing after upgrades, but never touch config.yaml
mkdir -p "$CONFIG_DIR"
mv "$TMP_DIR/config.example.yaml" "$CONFIG_DIR/config.example.yaml"
if [ ! -f "$CONFIG_DIR/config.yaml" ]; then
  cp "$CONFIG_DIR/config.example.yaml" "$CONFIG_DIR/config.yaml"
  echo "Created $CONFIG_DIR/config.yaml from example - edit it to set api-keys"
fi
rm -rf "$TMP_DIR"

# capture prior state before enable --now changes it
WAS_ACTIVE=0
systemctl --user is-active --quiet cli-proxy-api.service 2>/dev/null && WAS_ACTIVE=1

echo "Enabling cli-proxy-api.service..."
systemctl --user enable --now cli-proxy-api.service

# a running service keeps the old binary until restarted
if [ "$WAS_ACTIVE" = 1 ]; then
  echo "Restarting cli-proxy-api.service..."
  systemctl --user restart cli-proxy-api.service
fi

# --help exits 0 but keeps writing usage text after the version banner - capture
# the full output first so a piped `head -1` can't SIGPIPE it mid-write
VERSION_OUTPUT=$("$INSTALL_DIR/cli-proxy-api" --help 2>&1)
echo "cli-proxy-api $(echo "$VERSION_OUTPUT" | head -1) installed to $INSTALL_DIR/cli-proxy-api"
