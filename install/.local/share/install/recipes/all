#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

IS_SERVER=0
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  IS_SERVER=1
fi

run() {
  echo ""
  echo "==> $1"
  "$SCRIPT_DIR/$1"
}

# run a GUI app recipe — skipped on headless server environments
run_gui() {
  if [ "$IS_SERVER" = 1 ]; then
    echo ""
    echo "==> $1 (skipped: headless environment)"
    return
  fi
  run "$1"
}

# base tools
run starship
run go
run rust
run uv
run ruff
run bun
run gh
run aws
run ssm
run ripgrep
run shellcheck
run shfmt
run fzf
run bat
run just
run docker
run_gui 1password
run op
run gopass
run proton_pass

run fnm

run claude
run codex

run opencode
run neovim
run ghostty
run tmux
run_gui brave
run_gui lmstudio

echo ""
echo "All tools installed successfully."
