#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

IS_SERVER=0
if is_headless; then
  IS_SERVER=1
fi

run() {
  if recipe_is_installed "$1"; then
    recipe_announce_skip "$1"
    return
  fi
  echo ""
  echo "==> $1"
  "$SCRIPT_DIR/$1"
}

# run a GUI app recipe — skipped on headless server environments
run_gui() {
  if [ "$IS_SERVER" = 1 ]; then
    echo ""
    echo "==> $1 (skipped: headless environment)"
    return
  fi
  run "$1"
}

# base tools
run starship
run go
run rust
run uv
run ruff
run bun
run gh
run aws
run ssm
run ripgrep
run shellcheck
run shfmt
run fzf
run bat
run just
run docker
run_gui 1password
run op
run gopass
run proton_pass

run fnm
run pnpm

run claude
run codex
run grok
run pi
run cli-proxy-api

run opencode
run neovim
run ghostty
run tmux
run_gui brave
run_gui brave-origin
run_gui lmstudio
run_gui claude-desktop

echo ""
echo "All tools installed successfully."
