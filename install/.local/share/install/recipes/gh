#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="$HOME/.local/bin"
TMP_DIR=$(mktemp -d)

echo "Fetching latest gh release..."
LATEST=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
: "${LATEST:?failed to parse latest release tag}"
VERSION="${LATEST#v}"

echo "Installing gh $VERSION..."
curl -fsSL "https://github.com/cli/cli/releases/download/${LATEST}/gh_${VERSION}_linux_amd64.tar.gz" |
  tar -xz -C "$TMP_DIR"
mv "$TMP_DIR/gh_${VERSION}_linux_amd64/bin/gh" "$INSTALL_DIR/gh"
rm -rf "$TMP_DIR"

echo "gh $("$INSTALL_DIR/gh" --version | head -1) installed to $INSTALL_DIR/gh"
