#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

INSTALL_DIR="$HOME/.local/bin"
TMP_DIR=$(mktemp -d)
ARCH=$(recipe_arch uname)

echo "Fetching latest shellcheck release..."
LATEST=$(github_latest koalaman/shellcheck)
: "${LATEST:?failed to parse latest release tag}"
VERSION="${LATEST#v}"

echo "Installing shellcheck $VERSION..."
github_download koalaman/shellcheck "$LATEST" "shellcheck-${LATEST}.linux.${ARCH}.tar.xz" |
  tar -xJ -C "$TMP_DIR"
mv "$TMP_DIR/shellcheck-${LATEST}/shellcheck" "$INSTALL_DIR/shellcheck"
rm -rf "$TMP_DIR"

echo "shellcheck $($INSTALL_DIR/shellcheck --version | grep version:) installed to $INSTALL_DIR/shellcheck"
