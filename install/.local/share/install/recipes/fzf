#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

INSTALL_DIR="$HOME/.local/bin"
TMP_DIR=$(mktemp -d)
ARCH=$(recipe_arch deb)

echo "Fetching latest fzf release..."
LATEST=$(github_latest junegunn/fzf)
: "${LATEST:?failed to parse latest release tag}"
VERSION="${LATEST#v}"

echo "Installing fzf $VERSION..."
github_download junegunn/fzf "$LATEST" "fzf-${VERSION}-linux_${ARCH}.tar.gz" |
  tar -xz -C "$TMP_DIR"
mv "$TMP_DIR/fzf" "$INSTALL_DIR/fzf"
rm -rf "$TMP_DIR"

echo "fzf $($INSTALL_DIR/fzf --version) installed to $INSTALL_DIR/fzf"
